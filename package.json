{
  "name": "network-mapping-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade local Network Mapping & Patch Management Platform",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "keywords": [
    "network-mapping",
    "patch-panel",
    "switch-management",
    "vlan",
    "dcim"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "author": "Phoenix",
  "license": "MIT"
}
